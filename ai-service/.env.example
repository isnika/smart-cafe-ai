# Provider hiện tại dùng giao thức OpenAI-compatible. Giữ model/base URL đang
# được môi trường triển khai sử dụng; không commit API key thật.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.4
LLM_RETRY_MAX_SECONDS=4
LLM_TEMPERATURE=0.1

RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=4
RAG_MIN_SCORE=0.68
RAG_LEXICAL_WEIGHT=0.30
# false: cho phép tải model khi cache local chưa có; true: chạy lexical-only.
RAG_ALLOW_MODEL_DOWNLOAD=true
RAG_DISABLE_EMBEDDINGS=false
