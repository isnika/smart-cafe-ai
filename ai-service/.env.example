# Backend / Docker configuration
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.4
LLM_RETRY_MAX_SECONDS=4
LLM_TEMPERATURE=0.1
LLM_WARMUP=false

RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=4
RAG_MIN_SCORE=0.68
RAG_LEXICAL_WEIGHT=0.30
RAG_ALLOW_MODEL_DOWNLOAD=true
RAG_DISABLE_EMBEDDINGS=false
RAG_WARM_EMBEDDING_MODEL=true

DATA_API_BASE_URL=
DATA_API_KEY=
DATA_API_TIMEOUT_SECONDS=3
DATA_API_CATALOG_PATH=/api/ai/catalog/search
DATA_API_ORDER_PATH=/api/ai/orders/{order_code}

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://regime-qualities-unfortunately-norman.trycloudflare.com
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=false
CHAT_REINDEX_API_KEY=
CHAT_SOURCE_MODE=metadata
PRELOAD_CHAT=true

# For local Ollama outside Docker, use:
# LLM_BASE_URL=http://localhost:11434/v1

# Recommendation: live là mặc định; chỉ dùng demo khi chạy local/test.
RECOMMENDATION_SOURCE_MODE=live
RECOMMENDATION_SNAPSHOT_PATH=/api/ai/recommendation/snapshot
RECOMMENDATION_VIEWER_PATH=/api/ai/recommendation/viewer
RECOMMENDATION_CACHE_TTL_SECONDS=300
RECOMMENDATION_RECENCY_HALF_LIFE_DAYS=60
RECOMMENDATION_TRENDING_WINDOW_DAYS=30
RECOMMENDATION_MAX_QUANTITY_SIGNAL=8
RECOMMENDATION_MAX_ORDER_SIGNAL=20
RECOMMENDATION_MODEL_VERSION=hybrid-v2
