# Public ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_PORT=8001
DB_PORT=5432

# PostgreSQL used by the Spring backend
DB_NAME=smart_cafe_db
DB_USERNAME=admin
DB_PASSWORD=admin123
JWT_SECRET=change_this_secret_in_env

# The browser uses this URL; do not set it to http://backend:8080.
VITE_API_BASE_URL=http://localhost:8080

# AI provider. This example assumes Ollama is running on the host machine.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.4
LLM_RETRY_MAX_SECONDS=4
LLM_TEMPERATURE=0.1
LLM_WARMUP=false

# AI service / RAG
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=4
RAG_MIN_SCORE=0.68
RAG_LEXICAL_WEIGHT=0.30
RAG_ALLOW_MODEL_DOWNLOAD=true
RAG_DISABLE_EMBEDDINGS=false
RAG_WARM_EMBEDDING_MODEL=true
PRELOAD_CHAT=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
