# Local example. Set environment variables or load this file for your run configuration.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_cafe_payment_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
EUREKA_SERVER_URL=http://localhost:8761/eureka/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=smartcafe
RABBITMQ_PASSWORD=smartcafe-local
# Use the same Base64-encoded JWT signing secret across services.
JWT_SECRET=replace-with-the-same-base64-signing-secret

# Supply sandbox credentials from your payment providers.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=http://localhost:3000/payment/momo-return
MOMO_NOTIFY_URL=http://localhost:8085/payments/momo/ipn
