# Copy to engagement-service/.env, then run Maven from backend/.
# Keep this database separate from identity-service.
ENGAGEMENT_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_cafe_engagement_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
ENGAGEMENT_DATASOURCE_USERNAME=root
ENGAGEMENT_DATASOURCE_PASSWORD=change-me

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=smartcafe
RABBITMQ_PASSWORD=smartcafe-local
RABBITMQ_VHOST=/

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_SSL_ENABLE=false

# Optional: enables GET /api/v1/internal/notifications/{eventId} with X-Internal-Token.
NOTIFICATION_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Internal business commands use X-Service-Key. JWT_SECRET must match Identity.
ENGAGEMENT_INTERNAL_API_KEY=replace-with-a-different-long-random-secret
JWT_SECRET=replace-with-the-base64-signing-secret-configured-in-identity
ENGAGEMENT_CONSUMER_ENABLED=true
ENGAGEMENT_PUBLISHER_ENABLED=true
