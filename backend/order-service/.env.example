# --- DATABASE CONFIG ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_cafe_order_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# --- RABBITMQ CONFIG ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=smartcafe
RABBITMQ_PASSWORD=smartcafe-local
RABBITMQ_VHOST=/

# --- JWT SECURITY ---
# Use the same Base64-encoded JWT signing secret across services.
JWT_SECRET=replace-with-the-same-base64-signing-secret

# --- INTERNAL INTER-SERVICE KEYS ---
ORDER_INTERNAL_API_KEY=smart-cafe-internal-order-key
STORE_INTERNAL_API_KEY=smart-cafe-internal-store-key
CATALOG_INTERNAL_API_KEY=smart-cafe-internal-catalog-key
IDENTITY_INTERNAL_API_KEY=smart-cafe-internal-identity-key
ENGAGEMENT_INTERNAL_API_KEY=smart-cafe-internal-engagement-key

# --- INTERNAL BASE URLS (Optional) ---
STORE_INTERNAL_BASE_URL=http://localhost:8083/internal
CATALOG_INTERNAL_BASE_URL=http://localhost:8082/internal/catalog
IDENTITY_INTERNAL_BASE_URL=http://localhost:8081/api/v1/internal
ENGAGEMENT_INTERNAL_BASE_URL=http://localhost:8087/api/v1/internal

# Additional service configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka/
STORE_INTERNAL_AUTH_HEADER=X-Service-Key
ENGAGEMENT_RECOVERY_ENABLED=true
ORDER_IDENTITY_EVENTS_CONSUMER_ENABLED=true
ORDER_PAYMENT_TIMEOUT_MINUTES=15
ORDER_VAT_RATE=0
ORDER_EXPIRY_ENABLED=true
ORDER_EVENTS_PUBLISHER_ENABLED=true
ORDER_EVENTS_CONSUMER_ENABLED=false
# Legacy fallback if STORE_INTERNAL_API_KEY is unset:
# STORE_INTERNAL_AUTH_VALUE=smart-cafe-internal-store-key
