# --- DATABASE CONFIG ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_cafe_store_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
