# --- DATABASE CONFIG ---
# RabbitMQ: same values as engagement-service and Docker Compose.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=smartcafe
RABBITMQ_PASSWORD=smartcafe-local
RABBITMQ_VHOST=/smartcafe

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_cafe_identity_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# --- JWT SECURITY ---
GOOGLE_CLIENT_ID=
# Use the same Base64-encoded JWT signing secret across services.
JWT_SECRET=replace-with-the-same-base64-signing-secret

# --- CLOUDINARY CONFIG  ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Additional service configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka/
SHOW_SQL=false
IDENTITY_INTERNAL_API_KEY=smart-cafe-internal-identity-key
IDENTITY_EVENTS_PUBLISHER_ENABLED=true
IDENTITY_EVENTS_PUBLISH_DELAY_MS=1000
CONTACT_OTP_RESEND_COOLDOWN_SECONDS=60
CONTACT_OTP_MAX_REQUESTS_PER_HOUR=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
OTP_LOG_CODES=true
OTP_EMAIL_PUBLISHER_ENABLED=true
OTP_EMAIL_PUBLISH_DELAY_MS=1000
