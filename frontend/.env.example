# ── API ────────────────────────────────────────────────────────────────
# Relative API prefix: browser calls same-origin /api/v1/... and image Nginx proxies it.
# Keep relative for Docker; absolute URLs make the browser call the backend directly (CORS applies).
VITE_API_BASE_URL=/api/v1

# Docker image Nginx proxy endpoint. This is the API Gateway address reachable from this host.
API_PROXY_TARGET=http://host.docker.internal:8080

# true  → khởi động MSW (dữ liệu mock trong src/mocks)
# false → không khởi động MSW, mọi request đi tới VITE_API_BASE_URL
VITE_USE_MOCK=false

# Branch fallback khi Identity chưa trả branch_id cho Manager/Staff trong mock.
VITE_MOCK_AUTH_BRANCH_ID=1

# Cổng expose Vite dev server trên host.
FRONTEND_PORT=5173

# Image đã publish; thay username/tag theo image release thực tế.
FRONTEND_IMAGE=smartcafe/frontend:latest

# OAuth 2.0 Web client ID from Google Cloud Console (used by Google Identity Services)
VITE_GOOGLE_CLIENT_ID=
